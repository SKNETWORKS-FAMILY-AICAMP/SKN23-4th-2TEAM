# ── Frontend (Admin + Worker 공용, build-arg로 구분) ────────────────────────
# Build Args:
#   APP_DIR  - frontend_admin | frontend_worker
#   VITE_PORT - 5173 | 5174
#
# Targets:
#   dev  - Vite dev-server (HMR 지원, 개발용)
#   prod - Nginx 정적 서빙 (프로덕션)

ARG APP_DIR=frontend_admin
ARG VITE_PORT=5173

# ── Stage 1: dev (Vite dev-server) ─────────────────────────────────────────
FROM node:22-slim AS dev
ARG APP_DIR
ARG VITE_PORT=5173
# ARG → ENV 로 승격해야 런타임 CMD 에서 ${VITE_PORT} 가 빈값이 되지 않는다
ENV VITE_PORT=${VITE_PORT}

WORKDIR /app
COPY ${APP_DIR}/package.json ${APP_DIR}/package-lock.json ./
RUN npm ci --prefer-offline

COPY ${APP_DIR}/ .

EXPOSE ${VITE_PORT}
CMD ["sh", "-c", "npm run dev -- --config vite.config.docker.js --host 0.0.0.0 --port ${VITE_PORT}"]


# ── Stage 2: builder ────────────────────────────────────────────────────────
FROM node:22-slim AS builder
ARG APP_DIR

WORKDIR /app
COPY ${APP_DIR}/package.json ${APP_DIR}/package-lock.json ./
RUN npm ci --prefer-offline

COPY ${APP_DIR}/ .
RUN npm run build


# ── Stage 3: prod (Nginx + built assets) ───────────────────────────────────
FROM nginx:1.27-alpine AS prod
ARG APP_DIR

COPY --from=builder /app/dist /usr/share/nginx/html
# nginx conf는 docker-compose volumes mount 또는 아래 COPY 로 주입
COPY nginx/${APP_DIR}.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
