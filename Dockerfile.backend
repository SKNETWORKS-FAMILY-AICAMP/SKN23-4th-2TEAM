# ── Backend (Django Hub + FastAPI Worker API) ───────────────────────────────
# 두 백엔드는 같은 pyproject.toml로 관리되므로 단일 이미지를 빌드한다.
# CMD는 docker-compose.yml에서 서비스별로 오버라이드한다.
FROM python:3.12-slim AS base

# 시스템 패키지: PostgreSQL C 드라이버(psycopg2), 빌드 도구
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
        netcat-openbsd \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Poetry 설치 (공식 인스톨러 사용)
ENV POETRY_HOME=/opt/poetry \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_VIRTUALENVS_IN_PROJECT=false \
    POETRY_NO_INTERACTION=1

RUN curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

RUN pip install --no-cache-dir gunicorn

WORKDIR /app

# ── 의존성 설치 (소스보다 먼저 복사 → 레이어 캐시 재활용) ──────────────────
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root

# ── 프로젝트 소스 복사 ──────────────────────────────────────────────────────
COPY backend_hub/     ./backend_hub/
COPY backend_worker_api/ ./backend_worker_api/
COPY backend_ai/      ./backend_ai/

# 공유 데이터/모델 디렉터리 (볼륨 마운트 대상)
RUN mkdir -p data models logs backend_ai/bm25_data

# PYTHONPATH: backend_ai를 기본 경로에 포함
ENV PYTHONPATH=/app/backend_ai:/app

# ── Django 기본 CMD (docker-compose에서 각 서비스별로 오버라이드) ────────────
WORKDIR /app/backend_hub
CMD ["poetry", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]
